# WT32-ETH01: 4 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Ethernet: plenty of DMA buffers, full-size frames
CONFIG_ETH_DMA_BUFFER_SIZE=1522
CONFIG_ETH_DMA_RX_BUFFER_NUM=20
CONFIG_ETH_DMA_TX_BUFFER_NUM=20

# Wi-Fi: more buffers for forwarding
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ETH_IRAM_OPTIMIZATION=y

# Partitions: two 1.25 MB app slots (OTA later), 1.375 MB LittleFS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Throughput: full CPU clock and larger block-ack windows (default 6)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=16

# Lower the CPU clock to 80 MHz when idle (no light sleep, no Wi-Fi power save)
CONFIG_PM_ENABLE=y
